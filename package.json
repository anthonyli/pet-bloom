{
  "name": "pet-bloom",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:restore": "node scripts/test-restore.mjs",
    "test:watch": "vitest",
    "test:admin": "node scripts/admin-smoke.mjs",
    "deploy:vercel": "node scripts/deploy-vercel.mjs",
    "deploy:check": "node scripts/deploy-vercel.mjs --check",
    "db:check": "node scripts/migrate-turso.mjs --check",
    "db:migrate": "node scripts/migrate-turso.mjs",
    "desktop:dev": "node scripts/desktop.mjs --dev",
    "desktop:test": "node scripts/desktop-smoke.mjs",
    "desktop:build:mac": "node scripts/desktop.mjs --mac --all-arch",
    "desktop:build:mac:arm64": "node scripts/desktop.mjs --mac --arm64",
    "desktop:build:mac:x64": "node scripts/desktop.mjs --mac --x64",
    "desktop:build:win": "node scripts/desktop.mjs --win --x64",
    "desktop:release:prepare": "node scripts/desktop-release.mjs"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "date-holidays": "^3.38.0",
    "lucide-react": "^0.468.0",
    "next": "15.5.25",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "tailwind-merge": "^2.6.0",
    "yauzl": "3.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-updater": "6.8.11",
    "playwright-core": "1.64.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "yaml": "2.9.1"
  }
}
