# 数据库文件必须位于持久化磁盘；默认 ./data/pet-garden.db
DATABASE_PATH=./data/pet-garden.db
# 自托管 HTTPS 时设为 true；本机 HTTP 开发为 false
COOKIE_SECURE=false
# 可选：部署的公开地址，用于额外校验写请求来源
# APP_ORIGIN=https://your-domain.example

# Vercel / Turso (server-only; never commit a real token)
# 全局班级只读管理员：现有用户 UUID，逗号分隔；默认关闭。勿使用 NEXT_PUBLIC 前缀。
# Global read-only class admins: existing user UUIDs, comma-separated; disabled by default.
PET_GARDEN_ADMIN_USER_IDS=
# TURSO_DATABASE_URL=libsql://your-database.aws-ap-southeast-1.turso.io
# TURSO_AUTH_TOKEN=
# With no Turso URL, development and desktop use DATABASE_PATH.
# Vercel requires both Turso variables and always uses secure cookies.
