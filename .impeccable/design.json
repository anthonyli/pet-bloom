      "css": ".ds-tabs{display:flex;gap:4px;overflow-x:auto;border-radius:12px;background:#f0edf7;padding:4px}.ds-tab{flex-shrink:0;border:0;border-radius:8px;padding:8px 16px;background:transparent;color:#6e6a80;font-family:'PingFang SC','Microsoft YaHei',system-ui,sans-serif;font-size:14px;font-weight:500;line-height:20px;cursor:pointer;transition:color 150ms cubic-bezier(.4,0,.2,1),background-color 150ms cubic-bezier(.4,0,.2,1)}.ds-tab:hover{color:#26233b}.ds-tab-selected{background:#fff;color:#6d4aff;box-shadow:0 1px 2px 0 rgb(0 0 0 / .05)}.ds-tab:focus-visible{outline:2px solid var(--focus,#6d4aff);outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-tab{transition-duration:.01ms}}.ds-tab{display:inline-flex;align-items:center;gap:8px}"
